<Page
    x:Class="SophiApp.Views.StartupPage"
    xmlns:AnimatedVisuals="using:AnimatedVisuals"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    mc:Ignorable="d">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center">

        <AnimatedVisualPlayer Width="600"
                              Height="400"
                              Margin="-40, -100, 0, 0">
            <AnimatedVisuals:LottieLogoHelper/>
        </AnimatedVisualPlayer>

        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   Style="{StaticResource StartupPageTextStyle}"
                   Foreground="{ThemeResource WindowAccent}"
                   Margin="10, -90, 10, 0"/>

        <ProgressBar Value="{x:Bind ViewModel.ProgressBarValue, Mode=OneWay}"
                     Maximum="100"
                     Height="2"
                     Width="375"
                     Margin="10, -70, 10, 10"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{ThemeResource WindowAccent}"
                     Background="{ThemeResource ProgressBarBackground}"/>
    </StackPanel>
</Page>
