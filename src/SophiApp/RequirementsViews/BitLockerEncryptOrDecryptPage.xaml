<Page
    x:Class="SophiApp.RequirementsViews.BitLockerEncryptOrDecryptPage"
    x:Name="PageBitLockerEncryptOrDecrypt"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SophiApp.RequirementsViews"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:interaction="using:Microsoft.Xaml.Interactivity"
    mc:Ignorable="d">

    <Grid VerticalAlignment="Center"
          HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image Grid.Row="0"
               Source="/Assets/AppLogoBig.svg"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Width="373"
               Height="103"/>

        <StackPanel Grid.Row="1">
            <TextBlock Text="{x:Bind ViewModel.Text, Mode=OneWay}"
                       Style="{StaticResource RequirementsFailurePageTextStyle}"
                       Foreground="{ThemeResource WindowForeground}"/>
        </StackPanel>

        <Button x:Name="ButtonOpenBitLockerSettings"
                x:Uid="Button_OpenBitLockerSettings"
                Grid.Row="2"
                HorizontalAlignment="Center"
                Margin="0, 20, 0, 0"
                Style="{StaticResource BaseButton}"
                Command="{x:Bind ViewModel.OpenBitLockerSettingsCommand, Mode=OneWay}"/>

        <interactivity:Interaction.Behaviors>
            <interaction:DataTriggerBehavior Binding="{x:Bind ViewModel.IsHomeEdition, Mode=OneWay}" ComparisonCondition="Equal" Value="True">
                <interaction:ChangePropertyAction TargetObject="{Binding ElementName=ButtonOpenBitLockerSettings}" PropertyName="Visibility" Value="Collapsed"/>
            </interaction:DataTriggerBehavior>
            <interaction:DataTriggerBehavior Binding="{x:Bind ViewModel.IsHomeEdition, Mode=OneWay}" ComparisonCondition="Equal" Value="False">
                <interaction:ChangePropertyAction TargetObject="{Binding ElementName=ButtonOpenBitLockerSettings}" PropertyName="Visibility" Value="Visible"/>
            </interaction:DataTriggerBehavior>
        </interactivity:Interaction.Behaviors>
    </Grid>
</Page>
