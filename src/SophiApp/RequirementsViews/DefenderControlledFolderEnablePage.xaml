<Page
    x:Class="SophiApp.RequirementsViews.DefenderControlledFolderEnablePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SophiApp.RequirementsViews"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid VerticalAlignment="Center"
          HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image Grid.Row="0"
               Source="/Assets/AppLogoBig.svg"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Width="373"
               Height="103"/>

        <StackPanel Grid.Row="1">
            <TextBlock x:Uid="OsRequirementsFailure_DefenderControlledFolderEnable"
                       Style="{StaticResource RequirementsFailurePageTextStyle}"
                       Foreground="{ThemeResource WindowForeground}"/>

            <Button x:Uid="Button_OpenDefenderControlledFolderSettings"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Margin="0, 20, 0, 0"
                    Command="{x:Bind ViewModel.OpenDefenderControlledFolderCommand, Mode=OneWay}"/>
        </StackPanel>
    </Grid>
</Page>
