<Page
    x:Class="SophiApp.RequirementsViews.BitLockerProtectionStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SophiApp.RequirementsViews"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid VerticalAlignment="Center"
          HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image Grid.Row="0"
               Source="/Assets/AppLogoBig.svg"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               Width="373"
               Height="103"/>

        <StackPanel Grid.Row="1">
            <TextBlock x:Uid="OsRequirementsFailure_BitLockerProtectionState"
                       Style="{StaticResource RequirementsFailurePageTextStyle}"
                       Foreground="{ThemeResource WindowForeground}"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0, 20, 0, 0">
            <Button x:Uid="Button_Yes"
                    Margin="0, 0, 10, 0"
                    Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.BitLockerProtectionStatusCommand}">
                <Button.CommandParameter>
                    <x:Boolean>True</x:Boolean>
                </Button.CommandParameter>
            </Button>


            <Button x:Uid="Button_No"
                    Style="{StaticResource BaseButton}"
                    Command="{x:Bind ViewModel.BitLockerProtectionStatusCommand}">
                <Button.CommandParameter>
                    <x:Boolean>False</x:Boolean>
                </Button.CommandParameter>
            </Button>
        </StackPanel>
    </Grid>
</Page>
